<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="4dp"
    android:background="@drawable/bg_panel"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel_title_border"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:text="@string/signal_chain"
            android:textAllCaps="true"
            android:textColor="@color/cyan_dim"
            android:textSize="10sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="EQ"
            android:textColor="@color/muted"
            android:textSize="10sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="2dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:fontFamily="monospace" android:text="@string/sub_bass" android:textColor="@color/muted" android:textSize="10sp"/>
                <TextView android:id="@+id/val60" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="monospace" android:text="0dB" android:textColor="@color/muted" android:textSize="10sp"/>
            </LinearLayout>
            <SeekBar android:id="@+id/seek60" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:max="24" android:progress="12" android:progressTint="@color/cyan" android:thumbTint="@color/cyan"
                android:layout_marginBottom="14dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="2dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:fontFamily="monospace" android:text="@string/bass" android:textColor="@color/muted" android:textSize="10sp"/>
                <TextView android:id="@+id/val250" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="monospace" android:text="0dB" android:textColor="@color/muted" android:textSize="10sp"/>
            </LinearLayout>
            <SeekBar android:id="@+id/seek250" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:max="24" android:progress="12" android:progressTint="@color/cyan" android:thumbTint="@color/cyan"
                android:layout_marginBottom="14dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="2dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:fontFamily="monospace" android:text="@string/mid" android:textColor="@color/muted" android:textSize="10sp"/>
                <TextView android:id="@+id/val1000" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="monospace" android:text="0dB" android:textColor="@color/muted" android:textSize="10sp"/>
            </LinearLayout>
            <SeekBar android:id="@+id/seek1000" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:max="24" android:progress="12" android:progressTint="@color/cyan" android:thumbTint="@color/cyan"
                android:layout_marginBottom="14dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="2dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:fontFamily="monospace" android:text="@string/upper_mid" android:textColor="@color/muted" android:textSize="10sp"/>
                <TextView android:id="@+id/val4000" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="monospace" android:text="0dB" android:textColor="@color/muted" android:textSize="10sp"/>
            </LinearLayout>
            <SeekBar android:id="@+id/seek4000" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:max="24" android:progress="12" android:progressTint="@color/cyan" android:thumbTint="@color/cyan"
                android:layout_marginBottom="14dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="2dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:fontFamily="monospace" android:text="@string/treble" android:textColor="@color/muted" android:textSize="10sp"/>
                <TextView android:id="@+id/val12000" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="monospace" android:text="0dB" android:textColor="@color/muted" android:textSize="10sp"/>
            </LinearLayout>
            <SeekBar android:id="@+id/seek12000" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:max="24" android:progress="12" android:progressTint="@color/cyan" android:thumbTint="@color/cyan"
                android:layout_marginBottom="6dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_panel_title_border"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/hifi_boost"
                    android:textColor="@color/ink"
                    android:textSize="12sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/boostSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_panel_title_border"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/reduce_motion"
                    android:textColor="@color/ink"
                    android:textSize="12sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/motionSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingVertical="6dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:fontFamily="monospace" android:text="@string/sample_rate" android:textColor="@color/muted" android:textSize="10sp"/>
                    <TextView android:id="@+id/statRate" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="monospace" android:text="—" android:textColor="@color/ink" android:textSize="10sp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingVertical="6dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:fontFamily="monospace" android:text="@string/channels" android:textColor="@color/muted" android:textSize="10sp"/>
                    <TextView android:id="@+id/statCh" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="monospace" android:text="—" android:textColor="@color/ink" android:textSize="10sp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingVertical="6dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:fontFamily="monospace" android:text="@string/format" android:textColor="@color/muted" android:textSize="10sp"/>
                    <TextView android:id="@+id/statFmt" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="monospace" android:text="—" android:textColor="@color/ink" android:textSize="10sp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingVertical="6dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:fontFamily="monospace" android:text="@string/queue_position" android:textColor="@color/muted" android:textSize="10sp"/>
                    <TextView android:id="@+id/statPos" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="monospace" android:text="0 / 0" android:textColor="@color/ink" android:textSize="10sp"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
