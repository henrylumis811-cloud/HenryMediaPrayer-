<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="4dp"
    android:background="@drawable/bg_panel"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel_title_border"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:text="@string/verses"
            android:textAllCaps="true"
            android:textColor="@color/cyan_dim"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/lyricsTrackLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="@string/no_track"
            android:textColor="@color/muted"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:padding="6dp">

        <Button
            android:id="@+id/lyricsEditBtn"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_icon_button"
            android:paddingHorizontal="10dp"
            android:text="@string/edit"
            android:textAllCaps="true"
            android:textColor="@color/cyan_dim"
            android:textSize="10sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/lyricsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/lyricsBodyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/lyricsEditContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/lyricsEditText"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dropzone"
            android:fontFamily="monospace"
            android:gravity="top|start"
            android:hint="@string/lyrics_hint"
            android:inputType="textMultiLine"
            android:padding="10dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/lyricsCancelBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_icon_button"
                android:text="@string/cancel"
                android:textAllCaps="true"
                android:textColor="@color/ink"
                android:textSize="11sp" />

            <Button
                android:id="@+id/lyricsSaveBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_icon_button"
                android:text="@string/save"
                android:textAllCaps="true"
                android:textColor="@color/cyan"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
