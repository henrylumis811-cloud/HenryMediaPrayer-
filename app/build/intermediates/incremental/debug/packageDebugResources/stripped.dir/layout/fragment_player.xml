<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="4dp"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:padding="10dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.henrylumis.mediaprayer.ui.AltarView
            android:id="@+id/altarView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/nowPlayingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/awaiting_offering"
            android:textColor="@color/muted"
            android:fontFamily="monospace"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/nowPlayingArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:textColor="@color/cyan_dim"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/curTime"
            android:layout_width="34dp"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="0:00"
            android:textColor="@color/muted"
            android:textSize="9sp" />

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="1000"
            android:progressTint="@color/cyan"
            android:thumbTint="@color/cyan" />

        <TextView
            android:id="@+id/durTime"
            android:layout_width="34dp"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="0:00"
            android:textColor="@color/muted"
            android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="6dp">

        <ImageButton
            android:id="@+id/shuffleBtn"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_ctrl_btn"
            android:contentDescription="@string/tab_altar"
            android:padding="10dp"
            android:src="@drawable/ic_shuffle"
            app:tint="@color/ink" />

        <ImageButton
            android:id="@+id/prevBtn"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_ctrl_btn"
            android:contentDescription="@string/tab_altar"
            android:padding="8dp"
            android:src="@drawable/ic_prev"
            app:tint="@color/ink" />

        <ImageButton
            android:id="@+id/playBtn"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_ctrl_btn"
            android:contentDescription="@string/tab_altar"
            android:padding="14dp"
            android:src="@drawable/ic_play"
            app:tint="@color/ink" />

        <ImageButton
            android:id="@+id/nextBtn"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_ctrl_btn"
            android:contentDescription="@string/tab_altar"
            android:padding="8dp"
            android:src="@drawable/ic_next"
            app:tint="@color/ink" />

        <ImageButton
            android:id="@+id/repeatBtn"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_ctrl_btn"
            android:contentDescription="@string/tab_altar"
            android:padding="10dp"
            android:src="@drawable/ic_repeat"
            app:tint="@color/ink" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="4dp">

        <SeekBar
            android:id="@+id/volSeekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="100"
            android:progressTint="@color/gold"
            android:thumbTint="@color/gold" />

        <Spinner
            android:id="@+id/speedSpinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_icon_button"
            android:minWidth="64dp"
            android:paddingHorizontal="6dp" />

        <TextView
            android:id="@+id/visModeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_icon_button"
            android:fontFamily="monospace"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:text="@string/mandala"
            android:textColor="@color/cyan_dim"
            android:textSize="9sp" />
    </LinearLayout>

</LinearLayout>
