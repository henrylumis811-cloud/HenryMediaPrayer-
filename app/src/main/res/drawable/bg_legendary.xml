<?xml version="1.0" encoding="utf-8"?>
<!--
  Legendary-tech HUD backdrop: radial glow core + subtle circuit-style
  rings, rendered as layered vector/gradient drawables so it looks the
  same structurally in light and dark mode -- only the colors (pulled
  from colors.xml / values-night colors.xml) change.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_base" />
        </shape>
    </item>
    <item android:gravity="center" android:width="480dp" android:height="480dp" android:drawable="@drawable/ring_cyan" />
    <item android:gravity="center" android:width="620dp" android:height="620dp" android:drawable="@drawable/ring_violet" />
    <item android:gravity="center" android:width="340dp" android:height="340dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="170dp"
                android:centerColor="#220091B3"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
