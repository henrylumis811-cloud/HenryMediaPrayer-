<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.55"
        android:contentDescription="@null" />

    <com.henrylumis.mediaprayer.ui.ShaderBackgroundView
        android:id="@+id/shader_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#77000000" />

    <!-- Fixed Now Playing layout: no scrolling. Long metadata is constrained
         to its own area so it can never push the transport/volume controls off-screen. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Glass panel occupies the flexible upper area. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/now_playing_panel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_glass_panel"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="14dp"
            android:paddingBottom="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/transport_controls"
            app:layout_constraintVertical_bias="0">

            <TextView
                android:id="@+id/track_title"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="Nothing playing"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/track_artist"
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_marginTop="1dp"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textAllCaps="true"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Open Library to pick a song"
                app:layout_constraintTop_toBottomOf="@id/track_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:id="@+id/status_pill"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/bg_accent_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                app:layout_constraintTop_toBottomOf="@id/track_artist"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/playback_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="READY"
                    android:textColor="@color/accent_cyan"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <TextView
                android:id="@+id/track_album"
                android:layout_width="0dp"
                android:layout_height="18dp"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:alpha="0.82"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text=""
                app:layout_constraintTop_toBottomOf="@id/status_pill"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/queue_position"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text=""
                android:textColor="@color/text_secondary"
                android:textSize="9sp"
                android:letterSpacing="0.10"
                app:layout_constraintTop_toBottomOf="@id/track_album"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                app:layout_constraintTop_toBottomOf="@id/queue_position"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:layout_width="210dp"
                    android:layout_height="210dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ring_purple_thin"
                    android:alpha="0.85"
                    android:contentDescription="@null" />

                <ImageView
                    android:layout_width="190dp"
                    android:layout_height="190dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ring_gold_thin"
                    android:alpha="0.9"
                    android:contentDescription="@null" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/album_art"
                    android:layout_width="158dp"
                    android:layout_height="158dp"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_card"
                    android:src="@drawable/ic_album_placeholder"
                    app:shapeAppearanceOverlay="@style/CircleImageStyle" />

                <com.henrylumis.mediaprayer.ui.VisualizerView
                    android:id="@+id/visualizer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ImageButton
                    android:id="@+id/btn_visualizer_style"
                    android:contentDescription="Change visualizer style"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_chrome_button"
                    android:src="@android:drawable/ic_menu_gallery"
                    app:tint="@color/text_primary" />
            </FrameLayout>

            <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="top|start" android:layout_margin="6dp"
                android:src="@drawable/ic_screw" android:contentDescription="@null" />
            <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="top|end" android:layout_margin="6dp"
                android:src="@drawable/ic_screw" android:contentDescription="@null" />
            <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="bottom|start" android:layout_margin="6dp"
                android:src="@drawable/ic_screw" android:contentDescription="@null" />
            <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="bottom|end" android:layout_margin="6dp"
                android:src="@drawable/ic_screw" android:contentDescription="@null" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Fixed transport row. -->
        <LinearLayout
            android:id="@+id/transport_controls"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/timeline_header">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <ImageButton
                    android:id="@+id/btn_prev"
                    android:contentDescription="Previous track"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_chrome_button"
                    android:src="@android:drawable/ic_media_rew"
                    app:tint="@color/text_primary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="BACKWARD"
                    android:textColor="@color/text_secondary"
                    android:textSize="9sp"
                    android:letterSpacing="0.06" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_play_pause"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="12dp"
                android:text="PLAY"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:background="@drawable/bg_play_button"
                app:icon="@android:drawable/ic_media_play"
                app:iconTint="@color/text_primary"
                app:iconGravity="textStart"
                style="@style/Widget.MaterialComponents.Button" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <ImageButton
                    android:id="@+id/btn_next"
                    android:contentDescription="Next track"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_chrome_button"
                    android:src="@android:drawable/ic_media_ff"
                    app:tint="@color/text_primary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="FORWARD"
                    android:textColor="@color/text_secondary"
                    android:textSize="9sp"
                    android:letterSpacing="0.06" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/timeline_header"
            android:layout_width="0dp"
            android:layout_height="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/seek_bar">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TIMELINE"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:letterSpacing="0.08" />
            <TextView
                android:id="@+id/time_readout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:text="0:00 / 0:00" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seek_bar"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:progressDrawable="@drawable/seekbar_progress"
            android:thumb="@drawable/seekbar_thumb"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/volume_row" />

        <LinearLayout
            android:id="@+id/volume_row"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/action_row">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_lock_silent_mode_off"
                app:tint="@color/text_secondary"
                android:contentDescription="Volume" />
            <SeekBar
                android:id="@+id/volume_slider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:max="100"
                android:progressDrawable="@drawable/seekbar_progress"
                android:thumb="@drawable/seekbar_thumb" />
            <TextView
                android:id="@+id/volume_percent"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="end"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:text="0%" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/action_row"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageButton
                android:id="@+id/btn_shuffle"
                android:contentDescription="Shuffle off"
                android:tooltipText="Shuffle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_chrome_button"
                android:src="@drawable/ic_shuffle"
                android:padding="10dp"
                app:tint="@color/text_secondary" />

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp">

                <ImageButton
                    android:id="@+id/btn_repeat"
                    android:contentDescription="Repeat off"
                    android:tooltipText="Repeat"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_chrome_button"
                    android:src="@drawable/ic_repeat"
                    android:padding="10dp"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/repeat_one_badge"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="bottom|end"
                    android:gravity="center"
                    android:background="@drawable/bg_accent_pill"
                    android:text="1"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_playlist"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="ADD TO PLAYLIST"
                android:textSize="11sp"
                android:letterSpacing="0.04"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_chip_track"
                style="@style/Widget.MaterialComponents.Button.TextButton" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
